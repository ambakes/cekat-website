{
  "name": "cekat",
  "version": "2.0.0",
  "private": true,
  "description": "Edukasi anti-penipuan berbahasa Indonesia, dibangun dengan React dan TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/server.js",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && npm test && npm run check",
    "prepare:assets": "node --experimental-strip-types scripts/generate-bootstrap.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
